# CueBridge Memory 运行配置模板（复制为 .env 并填入真实密钥）
# ⚠️ 赛事要求：Embedding 必须 text-embedding-v4；LLM 组件必须 gpt-4o-mini；Reranker 不限

# ── 对外 Add/Search 服务 ──
AMC_HOST=0.0.0.0
AMC_PORT=8000
AMC_DB_PATH=./data/store/memory.db
AMC_BLOB_DIR=./data/store/blobs
AMC_EMBED_CACHE_PATH=./data/store/embcache.db
# 平台校验用的系统级密钥（客户端以 Authorization: Token <KEY> 调用）
MEMORY_SYSTEM_KEY=replace-with-a-long-random-secret

# ── Embedding（固定 text-embedding-v4，1024 维）──
AMC_EMBEDDING_BACKEND=dashscope
AMC_EMBEDDING_MODEL=text-embedding-v4
AMC_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AMC_EMBEDDING_API_KEY=sk-...            # DashScope
AMC_EMBEDDING_DIM=1024
AMC_EMBED_ON_ADD=1

# ── 检索骨干（Reranker 不限，本项目用 Qwen3-Reranker-4B）──
AMC_RETRIEVER=hybrid_round_rerank
AMC_FUSION=auto
AMC_RERANKER=qwen3
AMC_RERANKER_MODEL=/path/to/Qwen3-Reranker-4B
AMC_RERANKER_DEVICE=cuda
AMC_RERANK_UNIT=round

# ── LLM 证据选择档（强制 gpt-4o-mini）──
AMC_LLM_RERANK=1
AMC_LLM_RERANK_BASE_URL=https://your-gateway/v1
AMC_LLM_RERANK_API_KEY=sk-...
AMC_LLM_RERANK_MODEL=gpt-4o-mini
AMC_LLM_RERANK_PROMPT=evidence_set
AMC_LLM_RERANK_GATE_MARGIN=0
AMC_LLM_RERANK_DEDUP_ROUNDS=1
AMC_LLM_RERANK_POOL=12
AMC_LLM_RERANK_SKIP_MARKER=[Query image]

# ── image 路：查询图→文本桥 + 关系感知证据选择（同样用 gpt-4o-mini）──
AMC_QUERY_VISION=1
AMC_QUERY_VISION_BASE_URL=https://your-gateway/v1
AMC_QUERY_VISION_API_KEY=sk-...
AMC_QUERY_VISION_MODEL=gpt-4o-mini
AMC_RELATION_SELECT=1
AMC_RELATION_SELECT_BASE_URL=https://your-gateway/v1
AMC_RELATION_SELECT_API_KEY=sk-...
AMC_RELATION_SELECT_MODEL=gpt-4o-mini
AMC_RELATION_SELECT_POOL=14
